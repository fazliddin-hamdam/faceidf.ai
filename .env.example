# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Gemini API anahtarı (ücretsiz: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Türkçe -> İngilizce çeviri için kullanılan Gemini modeli
GEMINI_MODEL=gemini-3.5-flash-lite

# LFW görsellerinin bulunduğu klasör ve Qdrant veritabanı
LFW_DIR=data/lfw_funneled
QDRANT_PATH=qdrant_data
QDRANT_COLLECTION=faces

# CORS: GitHub Pages adresiniz (virgülle birden fazla yazılabilir). Test için * kullanılabilir.
ALLOWED_ORIGINS=https://KULLANICI_ADINIZ.github.io

# Backend'in dışarıdan erişilen HTTPS adresi (tünel / sunucu). Boş bırakılırsa istek adresinden türetilir.
PUBLIC_BASE_URL=

# Doldurulursa /search yalnızca bu botun Mini App'inden gelen (imzası doğrulanmış) istekleri kabul eder.
TELEGRAM_BOT_TOKEN=
